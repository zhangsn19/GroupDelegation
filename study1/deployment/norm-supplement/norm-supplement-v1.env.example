NODE_ENV=production
HOST=127.0.0.1
PORT=5003
STUDY_VERSION=group-deception-norm-supplement-v1
PROTOCOL_VERSION=group-deception-norm-supplement-v1
FORMAL_RECRUITMENT_ENABLED=false
ASSIGNMENT_MODE=prolific_taskflow
PROLIFIC_PREVIEW_MODE=true
PROLIFIC_VARIANT_MAP_JSON=__PRIVATE_THREE_CELL_MAPPING__
SERVER_RECORD_SECRET=__SERVER_ONLY_SECRET__
STUDY_CONTACT_EMAIL=__RESEARCH_CONTACT__
PID_DENYLIST_FILE=/etc/group-deception/norm-supplement-v1-denylist.sha256
DATA_DIR=/var/lib/group-deception/norm-supplement-v1/qa/sessions
FORMAL_DATA_DIR=/var/lib/group-deception/norm-supplement-v1/formal/sessions
PREVIEW_DATA_DIR=/var/lib/group-deception/norm-supplement-v1/preview/sessions
QA_DATA_DIR=/var/lib/group-deception/norm-supplement-v1/qa/sessions
TEAM_REVIEW_DATA_DIR=/var/lib/group-deception/norm-supplement-v1/team-review/sessions
LEGACY_STUDY1_DATA_DIR=__READ_ONLY_EXISTING_STUDY1_DIR__
ALLOW_QA_PREVIEW=true
ALLOW_TEAM_REVIEW=true
GIT_COMMIT=__NEW_COMMIT__
RELEASE_ID=__NEW_COMMIT__-norm-supplement-v1
