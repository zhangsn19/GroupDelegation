[Unit]
Description=Group Deception Norm Supplement
After=network.target

[Service]
Type=simple
User=group-deception
Group=group-deception
WorkingDirectory=__RELEASE_PATH__
EnvironmentFile=/etc/group-deception/norm-supplement-v1.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
